# Ignore node_modules (the root's and each application's)
**/node_modules

# Ignore npm debug logs
npm-debug.log

# Ignore build output and generated files, rebuilt in the image
**/build
**/.react-router
**/storybook-static
apps/web/generated

# Ignore environment variables
**/.env

# Ignore local data volumes (SQLite DB + image store)
data
apps/web/data

# Ignore local development files
.idea
.DS_Store

# Ignore test coverage reports
coverage

# Ignore temporary files
tmp
temp

# Ignore Docker files
.dockerignore
Dockerfile

# Ignore git files
.gitignore
.git

# Ignore example files
*.example

# Ignore Fly files
fly.toml

# Ignore cache files
.cache

# Ignore agent tooling (local Claude Code settings, skills)
.claude
.agents
