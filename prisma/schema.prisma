generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "sqlite"
  relationMode = "foreignKeys"
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  username           String                @unique
  name               String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  image              UserImage?
  password           Password?
  role               UserRole              @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId             String
  sessions           Session[]
  passkeys           Passkey[]
  connections        Connection[]
  backupCodes        BackupCode[]
  emergencyLinks     EmergencySignInLink[]
  filters            Filter[]
  author             Author                @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId           String                @unique
  colorScheme        ColorScheme           @default(system)
  // When the welcome row in Settings was closed (design 29e); null = still shown.
  welcomeDismissedAt DateTime?
}

// The administration's colour scheme (design 29a); system follows the device.
enum ColorScheme {
  system
  light
  dark
}

model UserImage {
  id                 String   @id @default(cuid())
  altText            String?
  // Image store metadata (see app/utils/image-store).
  version            String
  intrinsicWidth     Int
  intrinsicHeight    Int
  placeholderDataUrl String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId             String   @unique
}

model Password {
  hash   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model UserRole {
  id          String           @id @default(cuid())
  name        UserRoleName     @unique
  level       Int
  description String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions UserPermission[]
}

enum UserRoleName {
  owner
  administrator
  member
}

model UserPermission {
  id          String               @id @default(cuid())
  action      UserPermissionAction
  entity      UserPermissionEntity
  access      UserPermissionAccess
  description String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  roles       UserRole[]

  @@unique([action, entity, access])
}

enum UserPermissionAction {
  view
  create
  update
  delete
}

enum UserPermissionEntity {
  user
  author
}

enum UserPermissionAccess {
  own
  any
}

model Session {
  id              String   @id @default(cuid())
  expirationDate  DateTime
  // Last time the person proved who they are: the sign-in, or an identity check (#556).
  authenticatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId          String

  // non-unique foreign key
  @@index([userId])
}

model Passkey {
  id                   String       @id @default(cuid())
  credentialId         String       @unique
  credentialPublicKey  Bytes
  credentialCounter    BigInt
  credentialTransports String
  credentialDeviceType String
  credentialBackedUp   Boolean
  // Device and browser from the User-Agent at registration, built-in passkeys
  // only; null before #554.
  name                 String?
  // Where the passkey lives, from the registration response; null before #571.
  kind                 PasskeyKind?
  lastUsedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId               String

  // non-unique foreign key
  @@index([userId])
}

enum PasskeyKind {
  built_in
  security_key
  phone // a phone or tablet via QR code (hybrid)
}

model Connection {
  id           String   @id @default(cuid())
  providerName String
  providerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId       String

  @@unique([providerName, providerId])
  // non-unique foreign key
  @@index([userId])
}

model Verification {
  id        String    @id @default(cuid())
  // The type of verification, e.g. "email" or "phone"
  type      String
  // The thing we're trying to verify, e.g. a user's email or phone number
  target    String
  // The secret: the otp seed (TOTP) or the hashed token (magic link)
  secret    String
  // The algorithm used to generate the otp; null for non-otp types (magic link)
  algorithm String?
  // The number of digits in the otp; null for non-otp types (magic link)
  digits    Int?
  // The number of seconds the otp is valid for; null for non-otp types (magic link)
  period    Int?
  // The valid characters for the otp; null for non-otp types (magic link)
  charSet   String?
  // When it's safe to delete this verification
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([target, type])
}

// One-time sign-in link an Owner or Administrator issues during a Google outage
// (#578, design 28e/20f), only while ALLOW_PASSWORD_SIGN_IN is on. One row per
// issued link, so a replaced or expired link can still be tied to its account.
// Only the SHA-256 hash of the token is stored. issuedById has no relation, so
// the row outlives the issuer's account, like AuditLog.actorId.
model EmergencySignInLink {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  issuedById String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  replacedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String

  // non-unique foreign key
  @@index([userId])
}

// Single-use backup (recovery) codes: a fallback second factor for the
// break-glass password + TOTP flow. One row per code, hashed at rest (bcrypt,
// like Password.hash); redemption sets usedAt so a code works only once.
model BackupCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String

  // non-unique foreign key
  @@index([userId])
}

// The set of administration tables that support saved filters. This enum is the
// single source of truth: `AdminListTableKey` in app/utils/admin-list-filters.ts
// aliases it, so the filter-param registry cannot drift from the stored column.
enum FilterTable {
  archive
  article_categories
  article_tags
  articles
  authors
  podcast_episodes
  podcasts
}

// A named, per-user snapshot of an administration list's filter params. `query`
// holds the canonical serialized filter search with the search term (never
// page or sort) and is re-validated against the registry on save and on apply.
// At most one row per user and table may have `isDefault`; SQLite has no
// partial unique index, so that is enforced transactionally in the action.
model Filter {
  id        String      @id @default(cuid())
  name      String
  tableKey  FilterTable
  query     String
  isDefault Boolean     @default(false)
  isShared  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String

  // one preset name per user and table; its leading column also serves the
  // owner lookups, so no separate @@index([userId]) is needed
  @@unique([userId, tableKey, name])
  // shared presets listed across users
  @@index([tableKey, isShared])
}

model Author {
  id                         String            @id @default(cuid())
  name                       String
  bio                        String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  user                       User?
  role                       AuthorRole        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId                     String
  // Authored content
  articles                   Article[]         @relation("ArticleAuthors")
  // Created content
  articleTags                ArticleTag[]      @relation("ArticleTagCreator")
  articleCategories          ArticleCategory[] @relation("ArticleCategoryCreator")
  issues                     Issue[]           @relation("IssueCreator")
  podcasts                   Podcast[]         @relation("PodcastCreator")
  podcastEpisodes            PodcastEpisode[]  @relation("PodcastEpisodeCreator")
  pageSEOs                   PageSEO[]         @relation("PageSeoCreator")
  // Reviewed content
  reviews                    Review[]          @relation("ReviewsGiven")
  // Content submitted for review
  submittedArticles          Article[]         @relation("ArticleSubmissions")
  heldArticles               Article[]         @relation("ArticleEditHolds")
  heldIssues                 Issue[]           @relation("IssueEditHolds")
  heldPodcastEpisodes        PodcastEpisode[]  @relation("PodcastEpisodeEditHolds")
  submittedArticleTags       ArticleTag[]      @relation("ArticleTagSubmissions")
  submittedArticleCategories ArticleCategory[] @relation("ArticleCategorySubmissions")
  submittedIssues            Issue[]           @relation("IssueSubmissions")
  submittedPodcasts          Podcast[]         @relation("PodcastSubmissions")
  submittedPodcastEpisodes   PodcastEpisode[]  @relation("PodcastEpisodeSubmissions")
  // Content history entries this author caused
  contentLogs                ContentLog[]      @relation("ContentLogActor")
}

model AuthorRole {
  id          String             @id @default(cuid())
  name        AuthorRoleName     @unique
  level       Int
  description String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  authors     Author[]
  permissions AuthorPermission[]
}

enum AuthorRoleName {
  coordinator
  creator
  contributor
}

model AuthorPermission {
  id          String                 @id @default(cuid())
  action      AuthorPermissionAction
  entity      AuthorPermissionEntity
  access      AuthorPermissionAccess
  state       ContentState
  description String                 @default("")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  roles       AuthorRole[]

  @@unique([action, entity, access, state])
}

enum AuthorPermissionAction {
  view
  create
  update
  delete
  publish
  retract
  archive
  restore
  review
}

enum AuthorPermissionEntity {
  article
  article_tag
  article_category
  podcast
  podcast_episode
  issue
  page_seo
}

enum AuthorPermissionAccess {
  own
  any
}

model Issue {
  id              String       @id @default(cuid())
  // Null in a draft that has none yet; submitting and publishing require both (design 26e).
  year            Int?
  order           Int?
  name            String?
  supplement      String?
  // The supplement's slug, "" for a main issue, so the number is one key (design 26d).
  supplementSlug  String       @default("")
  // The number the issue holds once published (log 0039), `${year}-${order}` plus
  // `-${supplementSlug}`: the only unique one, written by publish and kept by
  // retract and archive. Two drafts may share a number.
  publishedNumber String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // The first save or upload; null is an empty draft (logs 0020, 0032).
  firstContentAt  DateTime?
  publishedAt     DateTime?
  state           ContentState @default(draft)
  cover           IssueCover?
  pdf             IssuePDF?
  author          Author       @relation("IssueCreator", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId        String
  reviews         Review[]     @relation("IssueReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt     DateTime?
  submittedById   String?
  submittedBy     Author?      @relation("IssueSubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The edit hold (design 07g, log 0019): free when there is no holder or heldUntil has passed.
  heldByAuthorId  String?
  heldByAuthor    Author?      @relation("IssueEditHolds", fields: [heldByAuthorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  heldByTabId     String?
  heldSince       DateTime?
  heldUntil       DateTime?

  @@index([year, order, supplementSlug])
  // non-unique foreign key
  @@index([authorId])
  @@index([submittedById])
  @@index([heldByAuthorId])
  // content-state query paths (own-access filtering, public list ordering)
  @@index([state, authorId])
  @@index([state, year, order])
}

model IssueCover {
  id                 String   @id @default(cuid())
  altText            String
  // Image store metadata (see app/utils/image-store).
  version            String
  intrinsicWidth     Int
  intrinsicHeight    Int
  placeholderDataUrl String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  issue              Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  issueId            String   @unique
}

model IssuePDF {
  id               String   @id @default(cuid())
  // Null until publish names it by the issue's number (logs 0033, 0039); a
  // retracted or archived issue keeps it.
  fileName         String?  @unique
  // The name it was uploaded under, which tells the final version (design 26b);
  // null for a file uploaded before it was kept.
  originalFileName String?
  uploadedAt       DateTime @default(now())
  contentType      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  issueId          String   @unique
}

model Podcast {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  description   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  state         ContentState     @default(draft)
  episodes      PodcastEpisode[]
  cover         PodcastCover?
  author        Author           @relation("PodcastCreator", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId      String
  reviews       Review[]         @relation("PodcastReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt   DateTime?
  submittedById String?
  submittedBy   Author?          @relation("PodcastSubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // non-unique foreign key
  @@index([authorId])
  @@index([submittedById])
  // content-state query paths (own-access filtering, public list ordering)
  @@index([state, authorId])
  @@index([state, publishedAt])
}

model PodcastCover {
  id                 String   @id @default(cuid())
  altText            String
  // Image store metadata (see app/utils/image-store).
  version            String
  intrinsicWidth     Int
  intrinsicHeight    Int
  placeholderDataUrl String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  podcast            Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  podcastId          String   @unique
}

model PodcastEpisode {
  id              String               @id @default(cuid())
  // What the editor typed, not unique; "" until the draft has an address.
  slug            String               @default("")
  // The address the episode holds in its podcast since its last publish; only publish writes it (log 0039).
  publishedSlug   String?
  // What the editor typed, not unique; null when cleared, submitting requires it (design 27h).
  number          Int?
  // The number the episode holds in its podcast since its last publish; only publish writes it (log 0039).
  publishedNumber Int?
  title           String               @default("")
  description     String               @default("")
  links           PodcastEpisodeLink[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  // The first save or upload; null is an empty draft (log 0020).
  firstContentAt  DateTime?
  publishedAt     DateTime?
  state           ContentState         @default(draft)
  podcast         Podcast              @relation(fields: [podcastId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  podcastId       String
  cover           PodcastEpisodeCover?
  author          Author               @relation("PodcastEpisodeCreator", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId        String
  reviews         Review[]             @relation("PodcastEpisodeReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt     DateTime?
  submittedById   String?
  submittedBy     Author?              @relation("PodcastEpisodeSubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The edit hold (design 07g, log 0019): free when there is no holder or heldUntil has passed.
  heldByAuthorId  String?
  heldByAuthor    Author?              @relation("PodcastEpisodeEditHolds", fields: [heldByAuthorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  heldByTabId     String?
  heldSince       DateTime?
  heldUntil       DateTime?

  // the number is unique within the podcast once published (log 0039)
  @@unique([podcastId, publishedNumber])
  // the public address is the podcast's and the episode's (/podcasts/:podcastSlug/:episodeSlug)
  @@unique([podcastId, publishedSlug])
  // the next free number and a draft's web preview by the typed address
  @@index([podcastId, number])
  @@index([podcastId, slug])
  // non-unique foreign key
  @@index([podcastId])
  @@index([authorId])
  @@index([submittedById])
  @@index([heldByAuthorId])
  // content-state query paths (own-access filtering, public list ordering)
  @@index([state, authorId])
  @@index([state, publishedAt])
}

model PodcastEpisodeLink {
  id        String         @id @default(cuid())
  url       String
  label     String
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  episodeId String

  // non-unique foreign key
  @@index([episodeId])
}

model PodcastEpisodeCover {
  id                 String         @id @default(cuid())
  altText            String
  // Image store metadata (see app/utils/image-store).
  version            String
  intrinsicWidth     Int
  intrinsicHeight    Int
  placeholderDataUrl String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  episode            PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  episodeId          String         @unique
}

model Article {
  id              String            @id @default(cuid())
  // What the editor typed, not unique; null until the draft has an address (design 24a).
  slug            String?
  // The address the article holds since its last publish; only publish writes it (log 0039).
  publishedSlug   String?           @unique
  title           String
  perex           String?
  content         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // The first save with a title, text or image; null is an empty draft (log 0020).
  firstContentAt  DateTime?
  publishedAt     DateTime?
  state           ContentState      @default(draft)
  authors         Author[]          @relation("ArticleAuthors")
  images          ArticleImage[]    @relation("ArticleImages")
  featuredImageId String?           @unique
  featuredImage   ArticleImage?     @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tags            ArticleTag[]
  categories      ArticleCategory[]
  reviews         Review[]          @relation("ArticleReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt     DateTime?
  submittedById   String?
  submittedBy     Author?           @relation("ArticleSubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The edit hold (design 07g, log 0019): free when there is no holder or heldUntil has passed.
  heldByAuthorId  String?
  heldByAuthor    Author?           @relation("ArticleEditHolds", fields: [heldByAuthorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  heldByTabId     String?
  heldSince       DateTime?
  heldUntil       DateTime?

  // content-state query path (public list ordering; authors are M:N, no authorId FK)
  @@index([state, publishedAt])
  // a draft's web preview finds it by the typed address
  @@index([slug])
  // non-unique foreign keys
  @@index([submittedById])
  @@index([heldByAuthorId])
}

model ArticleImage {
  id                 String   @id @default(cuid())
  altText            String
  description        String?
  // Image store metadata (see app/utils/image-store).
  version            String
  intrinsicWidth     Int
  intrinsicHeight    Int
  placeholderDataUrl String
  // The picked file's name, under the tile's fields; none for older images (24b).
  fileName           String?
  // The order in the article's gallery and on the web (design 24b).
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  article            Article  @relation("ArticleImages", fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleId          String
  featuredInArticle  Article? @relation("ArticleFeaturedImage")

  // non-unique foreign key
  @@index([articleId])
}

model ArticleTag {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  publishedAt   DateTime?
  state         ContentState @default(draft)
  articles      Article[]
  author        Author       @relation("ArticleTagCreator", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId      String
  reviews       Review[]     @relation("ArticleTagReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt   DateTime?
  submittedById String?
  submittedBy   Author?      @relation("ArticleTagSubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // non-unique foreign key
  @@index([authorId])
  @@index([submittedById])
  // content-state query path (own-access filtering)
  @@index([state, authorId])
}

model ArticleCategory {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  publishedAt   DateTime?
  state         ContentState @default(draft)
  articles      Article[]
  author        Author       @relation("ArticleCategoryCreator", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorId      String
  reviews       Review[]     @relation("ArticleCategoryReviews")
  // A draft its author sent for review (design 07d); null when not submitted.
  submittedAt   DateTime?
  submittedById String?
  submittedBy   Author?      @relation("ArticleCategorySubmissions", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // non-unique foreign key
  @@index([authorId])
  @@index([submittedById])
  // content-state query path (own-access filtering)
  @@index([state, authorId])
}

model PageSEO {
  id              String       @id @default(cuid())
  pathname        String       @unique
  title           String?
  description     String?
  robots          String       @default("index, follow")
  ogImageUrl      String?
  twitterImageUrl String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  publishedAt     DateTime?
  state           ContentState @default(draft)
  // Whoever first saved the page; nothing shows it, so deleting the author
  // clears it rather than holding the author (#767).
  authorId        String?
  author          Author?      @relation("PageSeoCreator", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviews         Review[]     @relation("PageSEOReviews")

  // non-unique foreign key
  @@index([authorId])
  // content-state query path (own-access filtering)
  @@index([state, authorId])
}

enum ContentState {
  draft
  published
  archived
}

model Review {
  id                String           @id @default(cuid())
  state             ReviewState      @default(approved)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reviewerId        String
  reviewer          Author           @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Content entity relations
  issueId           String?
  issue             Issue?           @relation("IssueReviews", fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleId         String?
  article           Article?         @relation("ArticleReviews", fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  podcastId         String?
  podcast           Podcast?         @relation("PodcastReviews", fields: [podcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  podcastEpisodeId  String?
  podcastEpisode    PodcastEpisode?  @relation("PodcastEpisodeReviews", fields: [podcastEpisodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleTagId      String?
  articleTag        ArticleTag?      @relation("ArticleTagReviews", fields: [articleTagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleCategoryId String?
  articleCategory   ArticleCategory? @relation("ArticleCategoryReviews", fields: [articleCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pageSEOId         String?
  pageSEO           PageSEO?         @relation("PageSEOReviews", fields: [pageSEOId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reviewerId])
  @@index([issueId])
  @@index([articleId])
  @@index([podcastId])
  @@index([podcastEpisodeId])
  @@index([articleTagId])
  @@index([articleCategoryId])
  @@index([pageSEOId])
}

enum ReviewState {
  approved
}

enum AuthLogEvent {
  sign_in_success
  sign_in_failure
  two_factor_failure
  sign_out
  identity_check_success
  identity_check_failure
}

enum AuthMethod {
  password
  magic_link
  google
  passkey
  two_factor
  backup_code
  emergency_link
}

// Authentication log. Deliberately has no relation to User so events survive
// account deletion. `method` is nullable because sign-out has none.
model AuthLog {
  id                    String       @id @default(cuid())
  createdAt             DateTime     @default(now())
  event                 AuthLogEvent
  method                AuthMethod? // null for sign-out
  userId                String? // set when the user is known
  email                 String? // submitted email on failures where no user exists
  ipAddress             String?
  userAgent             String?
  // The emergency link a sign-in attempt used (#578); names its issuer.
  emergencySignInLinkId String?

  @@index([createdAt])
  @@index([userId])
}

enum AuditLogEvent {
  user_created
  user_deleted
  user_role_changed
  author_role_changed
  emergency_link_issued
  author_created
  user_email_changed
}

// Administrative audit log (user management, role changes). Deliberately has no
// relation to User so records survive account deletion. No retention pruning:
// volume is tiny and the forensic value is permanent.
model AuditLog {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  event     AuditLogEvent
  actorId   String // user id of the administrator performing the action
  targetId  String // user id (or author id for author_created and author_role_changed) of the affected account
  detail    String? // e.g. "role: member → administrator"
  ipAddress String?

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
}

enum ContentLogEntity {
  article
  article_tag
  article_category
  issue
  podcast
  podcast_episode
}

enum ContentLogEvent {
  create
  update
  submit
  withdraw
  return
  approve
  publish
  set_published_at
  unpublish
  archive
  restore
  pdf_uploaded
  cover_uploaded
  take_over
}

// Content history (design 07f): who did what to a piece of content and when. The
// content id is polymorphic, so there is no foreign key; the rows are removed with
// their content, and the deletion itself is not logged.
model ContentLog {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  entity    ContentLogEntity
  entityId  String
  event     ContentLogEvent
  actor     Author?          @relation("ContentLogActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId   String?
  detail    String? // set_published_at: "<from ISO> → <to ISO>"

  @@index([entity, entityId, createdAt])
  @@index([actorId])
}
