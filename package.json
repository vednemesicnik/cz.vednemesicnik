{
  "dependencies": {
    "@remix-run/compression-middleware": "1.0.3",
    "@remix-run/fetch-router": "1.0.1",
    "@remix-run/logger-middleware": "1.0.1",
    "@remix-run/node-fetch-server": "1.0.1",
    "@remix-run/static-middleware": "1.0.3",
    "@sentry/react-router": "10.72.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "name": "cz.vednemesicnik",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "scripts": {
    "app:build": "pnpm --filter web app:build",
    "app:dev": "pnpm --filter web app:dev",
    "app:routes:generate": "pnpm --filter web app:routes:generate",
    "app:start": "node --enable-source-maps server.ts",
    "app:start-with-sentry": "node --enable-source-maps --import ./instrument.server.ts server.ts",
    "app:typecheck": "pnpm --filter web app:typecheck && tsc",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --write",
    "biome:check:push": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "biome:check:staged": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "biome:format": "biome format",
    "biome:format:fix": "biome format --write",
    "biome:format:staged": "biome format --write --no-errors-on-unmatched",
    "biome:lint": "biome lint",
    "biome:lint:fix": "biome lint --write",
    "biome:lint:staged": "biome lint --write --no-errors-on-unmatched",
    "build-storybook": "pnpm --filter web build-storybook",
    "claude:skills:link": "sh ./scripts/link-claude-skills.sh",
    "db:backup": "sh ./scripts/backup-database.sh",
    "design:screen": "pnpm --filter web design:screen",
    "docker:compose:down": "sh ./scripts/docker-compose-down.sh",
    "docker:compose:up": "sh ./scripts/docker-compose-up.sh",
    "gas:schema:fetch": "pnpm --filter web gas:schema:fetch",
    "gas:types:generate": "pnpm --filter web gas:types:generate",
    "generate:static-images": "pnpm --filter web generate:static-images",
    "lefthook:install": "lefthook install",
    "lefthook:pre-commit": "lefthook run pre-commit",
    "lefthook:pre-push": "lefthook run pre-push",
    "prisma:db:push": "pnpm --filter web prisma:db:push",
    "prisma:db:seed": "pnpm --filter web prisma:db:seed",
    "prisma:format": "pnpm --filter web prisma:format",
    "prisma:generate": "pnpm --filter web prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter web prisma:migrate:deploy",
    "prisma:migrate:dev": "pnpm --filter web prisma:migrate:dev",
    "prisma:migrate:dev-init": "pnpm --filter web prisma:migrate:dev-init",
    "prisma:migrate:reset": "pnpm --filter web prisma:migrate:reset",
    "prisma:studio": "pnpm --filter web prisma:studio",
    "prisma:studio:prod": "pnpm --filter web prisma:studio:prod",
    "secret:generate": "sh ./scripts/generate-secret.sh",
    "sql:generate": "pnpm --filter web sql:generate",
    "storybook": "pnpm --filter web storybook",
    "test": "pnpm --filter web test && vitest run"
  },
  "type": "module"
}
