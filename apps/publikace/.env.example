# Template for .env. Never put a real value here — this file is tracked and the repository is public.
# Every variable the app reads or will read, by name and purpose.
# On Fly.io every one of them is a `fly secrets` entry, not a line in fly.toml.

# Google sign-in for the editors-in-chief (OAuth client of the vednemesicnik.cz Workspace, Internal).
# Its authorised redirect URIs must include APP_ORIGIN followed by /sign-in/google/callback, locally
# http://localhost:44100/sign-in/google/callback. Without a client nobody can sign in, and every attempt
# ends as `?error=oauth`. The same client connects publikace.app@ in Settings: it also needs
# APP_ORIGIN followed by /settings/account/callback and the https://www.googleapis.com/auth/drive
# scope on its consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the app is reached, for the address Google returns to (its /sign-in/google/callback must be an
# authorised redirect URI of the client). Defaults to http://localhost:44100 outside production.
APP_ORIGIN=

# The Workspace domain every account must be on, without the @ (vednemesicnik.cz in production). Moving it
# is a deployment, not a setting. Empty lets nobody in; production refuses to start with it empty.
AUTHORIZED_DOMAIN=

# Signs the session cookie and the expiry marker. Several, comma-separated, during a rotation: the newest
# first. Optional locally, where a fixed development value is used; required in production.
SESSION_SECRET=

# The first administrator, added when the access list has no named account. Production refuses to start
# with an empty list and no value here. Locally, your own address, so a fresh database lets you in.
INITIAL_ADMIN_EMAIL=

# SCRIPT__Auth__Group_Membership: its web app URL and the shared secret its requests carry in their
# body. It answers whether an account is in a group listed in Settings, and only about groups in its
# own allowedGroups (config.gs). Optional locally: without it a named account still signs in, a member
# of a group gets `?error=unavailable`, and a group cannot be added.
GAS_GROUP_MEMBERSHIP_URL=
GAS_GROUP_MEMBERSHIP_SECRET=

# The SQLite database, the source of truth. Defaults to ./db/publikace.sqlite locally (and in
# `remix db`, see remix.json); on Fly.io a path on the mounted volume.
DATABASE_PATH=

# The account that creates folders and documents on the shared drive: the only one Settings accepts
# when it is connected (publikace.app@vednemesicnik.cz). Its token is not configured here: an
# editor-in-chief connects the account in Settings and the app keeps the token in its database.
DRIVE_ACCOUNT_EMAIL=

# Encrypts that token in the database: base64 of 32 random bytes, generated with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# A new key makes the stored token unreadable, and the account has to be connected again.
DRIVE_TOKEN_KEY=

# The Registr spreadsheet (list "Vydání"), a record the app writes and never reads. Use a test one locally.
REGISTRY_SPREADSHEET_ID=

# The folder on the shared drive "Publikace" that holds every issue, and the template every article Doc
# is copied from. The template's body carries {{NAZEV_CLANKU}}, which the app replaces with the article's
# name through the Google Docs API: enable that API in the OAuth client's Cloud project. Use test ones
# locally.
ISSUES_FOLDER_ID=
ARTICLE_TEMPLATE_DOCUMENT_ID=

# The Mailer of the publikace@ mailbox (SCRIPT__Mail__Send): its web app URL and the secret its requests are signed with.
# Optional locally: without it an article is still created and its welcome e-mails are logged as not sent.
MAIL_SEND_URL=
MAIL_SEND_SECRET=

# The most e-mails the public pages may start in one day (Prague time), the welcome e-mails of a new article and
# the consent requests for artworks together, the editors' resends included. A leaked link cannot then use the
# mailbox to send without end. Optional: 300 when empty.
PUBLIC_MAIL_PER_DAY=

# Calls from the background jobs (the reply check of artworks first) carry a Google ID token. Its expected audience,
# comma-separated (the OAuth client of the jobs' Google Cloud project), and the account the jobs run as
# (publikace.app@vednemesicnik.cz). Both required in production; outside it any audience, and DRIVE_ACCOUNT_EMAIL.
SCRIPT_TOKEN_AUDIENCE=
SCRIPT_JOB_ACCOUNT=

# The audiences an identity token from the article Doc's menu may carry, comma-separated, or * for any. Every Doc
# carries its own copy of the bound script in a default Cloud project of its own, so the tokens share no audience and
# production sets *. The token then proves only whose account it is; Drive's answer decides whether that account may
# act (#50, docs/real-drive-round-trip.md). Required in production; * when empty outside it.
DOC_MENU_TOKEN_AUDIENCES=

# Signs the app's calls to a job's doPost ("Spustit teď"). The same value is in that project's Script Properties.
SCRIPT_RUN_SECRET=
