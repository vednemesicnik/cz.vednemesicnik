# Template for .env. Never put a real value here — this file is tracked and the repository is public.
# The app does not exist yet; these are the variables the design assumes, by name and purpose.

# Google sign-in for the editors-in-chief (OAuth client of the vednemesicnik.cz Workspace).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie.
SESSION_SECRET=

# The account that creates folders, documents and rows on Drive (publikace.app@vednemesicnik.cz).
DRIVE_ACCOUNT_REFRESH_TOKEN=

# The mailbox that sends e-mails and reads the replies (publikace@vednemesicnik.cz).
MAIL_ACCOUNT_REFRESH_TOKEN=

# The Registr spreadsheet (list "Vydání") and the folder that holds every issue. Use test ones locally.
REGISTRY_SPREADSHEET_ID=
ISSUES_FOLDER_ID=
ARTICLE_TEMPLATE_DOCUMENT_ID=
