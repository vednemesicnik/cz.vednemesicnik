# Template for .env. Never put a real value here — this file is tracked and the repository is public.
# The app does not exist yet; these are the variables the design assumes, by name and purpose.
# On Fly.io every one of them is a `fly secrets` entry, not a line in fly.toml.

# Google sign-in for the editors-in-chief (OAuth client of the vednemesicnik.cz Workspace, Internal).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie.
SESSION_SECRET=

# The first administrator, the one account that may change who signs in until it names others in Settings.
INITIAL_ADMIN_EMAIL=

# SCRIPT__Auth__Group_Membership, the service Fakturace uses too: its web app URL and the shared secret
# its requests carry. It answers whether an account is in a group named in Settings.
GAS_GROUP_MEMBERSHIP_URL=
GAS_GROUP_MEMBERSHIP_SECRET=

# The SQLite database, the source of truth. On Fly.io a path on the mounted volume.
DATABASE_PATH=

# The account that creates folders and documents on the shared drive (publikace.app@vednemesicnik.cz).
DRIVE_ACCOUNT_REFRESH_TOKEN=

# The Registr spreadsheet (list "Vydání"), a record the app writes and never reads. Use a test one locally.
REGISTRY_SPREADSHEET_ID=

# The folder on the shared drive "Publikace" that holds every issue, and the template every article Doc
# is copied from. Use test ones locally.
ISSUES_FOLDER_ID=
ARTICLE_TEMPLATE_DOCUMENT_ID=

# The Mailer of the publikace@ mailbox (SCRIPT__Mail__Send): its web app URL and the secret its requests are signed with.
MAIL_SEND_URL=
MAIL_SEND_SECRET=

# Calls from the Apps Script projects carry a Google ID token. Its expected audience (the OAuth client of their
# Google Cloud project) and the account the background jobs run as (publikace.app@vednemesicnik.cz).
SCRIPT_TOKEN_AUDIENCE=
SCRIPT_JOB_ACCOUNT=

# Signs the app's calls to a job's doPost ("Spustit teď"). The same value is in that project's Script Properties.
SCRIPT_RUN_SECRET=
