node_modules/

# Secrets: the Google OAuth client, the token of publikace.app@ and the secrets for the Mailer
# and the scripts live in .env locally and in `fly secrets` once deployed. `.env.example` is
# the tracked template and must never hold a real value.
.env
.env.*
!.env.example

# The local database and its WAL files (DATABASE_PATH defaults to db/publikace.sqlite).
db/*.sqlite
db/*.sqlite-shm
db/*.sqlite-wal

# Scratch drafts (/ask-copy questions, probes, saved design files).
tmp/

.coverage/

# The scaffold's own Remix skill, copied rather than carried: `pnpm dev:setup-claude`
# copies it from `@remix-run/cli`'s `template/`, pinned by the lockfile.
.agents/skills/remix/

# Somebody else's guides, fetched rather than carried. `skills-lock.json` names the source
# and pins a hash, so `pnpm dev:setup-claude` restores this exact revision.
.agents/skills/modern-web-guidance/

# Editors and OS noise.
.idea
.DS_Store

# Claude Code's own directory and the guide file named after it. `pnpm dev:setup-claude`
# writes both: `skills/` is symlinks into `.agents/skills/`, `CLAUDE.md` imports `AGENTS.md`.
# `agents/` is the one tracked path: a subagent is read from there and nowhere else.
.claude/*
!.claude/agents/
CLAUDE.md

# Session notes of the Remember plugin.
.remember/
