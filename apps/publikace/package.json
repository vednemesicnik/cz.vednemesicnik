{
  "name": "cz-vednemesicnik-publikace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "case \"$CI\" in ''|0|false) lefthook install || echo \"lefthook install failed; run pnpm exec lefthook install by hand\";; esac",
    "app:dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "app:start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "app:doctor": "remix doctor",
    "test": "remix test --type server",
    "db:status": "remix db status",
    "db:migrate": "remix db migrate",
    "db:rollback": "remix db rollback",
    "design:screen": "node scripts/design-screen.ts",
    "dev:setup-claude": "node scripts/setup-claude.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --max-warnings=0",
    "lint:fix": "oxlint . --fix --max-warnings=0",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
